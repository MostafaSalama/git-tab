{
  "manifest_version": 3,
  "name": "GitTab",
  "version": "1.1.0",
  "description": "Save, organize, and restore your browser tabs like Git commits. Lightweight tab manager that frees up memory.",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "favicon",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GitTab — Tab Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "commit-current-tab": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Commit current tab to Read Later"
    },
    "commit-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Commit all tabs in this window"
    }
  }
}
